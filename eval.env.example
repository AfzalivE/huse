# Copy this file to ~/.heval/eval.env (outside the repo), fill it in, and run:
#   chmod 600 ~/.heval/eval.env
# heval loads it. Never commit it.

# Claude Code: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_FORCE_OAUTH=1

# Codex: a separate login for evals (see the setup steps in docs/heval.md).
CODEX_AUTH_JSON_PATH=$HOME/.heval/logins/codex/auth.json

# pi: a separate ChatGPT Plus/Pro login for evals.
PI_AUTH_JSON_PATH=$HOME/.heval/logins/pi/auth.json

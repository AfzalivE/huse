# Copy this file to ~/.harness/eval.env (outside the repo), fill it in, and run:
#   chmod 600 ~/.harness/eval.env
# heval loads it. Never commit it.

# Claude Code: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_FORCE_OAUTH=1

# Codex: a separate login for evals (see the setup steps).
CODEX_AUTH_JSON_PATH=$HOME/.harness/eval-codex/auth.json

# pi: a separate ChatGPT Plus/Pro login for evals.
PI_AUTH_JSON_PATH=$HOME/.harness/eval-pi/auth.json

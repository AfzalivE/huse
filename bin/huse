#!/usr/bin/env bash
# huse - switch agent harness profiles for Claude Code, Codex and pi, one shell at a time.
#
# Install: put the repo's bin/ folder on your PATH.
# Profiles live in $HARNESS_ROOT (default ~/.harness), not in the repo.
#
# `huse use <profile>` changes only the current shell: CLAUDE_CONFIG_DIR, CODEX_HOME
# and PI_CODING_AGENT_DIR point at the profile.
#
# Skills live in one store, $HARNESS_ROOT/skills. Each harness folder of a profile has
# links to the skills that it uses (`huse skill add`). Codex and pi also read
# ~/.agents/skills in every profile, so `huse setup` moves those skills to the store.
#
# A program cannot change the shell that started it. Thus, without shell
# integration, `huse use` opens a new shell (type exit to leave).
# With `eval "$(huse init)"` in ~/.zshrc or ~/.bashrc, `huse use` and `huse off`
# change the current shell instead.

HUSE_VERSION="0.1.0"
HARNESS_ROOT="${HARNESS_ROOT:-$HOME/.harness}"
STORE="$HARNESS_ROOT/skills"
HARNESSES="claude codex pi"

_huse_help() {
  cat >&2 <<'EOF'
usage:
  huse new <profile> [--from system|<profile>]  make a profile (empty, or copied)
  huse use <profile>                            use a profile in this shell (a new shell, or this shell with init)
  huse off                                      go back to your normal setup
  huse run <profile> <cmd> [args...]            run one command with a profile
  huse ls                                       list profiles
  huse status                                   show what is active
  huse setup                                    move the skills in ~/.agents/skills to the store
  huse skill ls [<profile>]                     list the skills in the store, and where a profile uses them
  huse skill add <profile> <skill> [<harness>...]  use a skill of the store in a profile
  huse skill rm <profile> <skill> [<harness>...]   stop using a skill in a profile
  huse init                                     print shell integration: eval "$(huse init)"
  huse --version                                print the version

<profile> is a profile name that you chose with `huse new`. "system" means your normal setup.
<harness> is claude, codex, or pi. Without one, add and rm change all three.
EOF
}

_huse_dir() { printf '%s/profiles/%s' "$HARNESS_ROOT" "$1"; }

# Profile directory, or an error.
_huse_profile() {
  local name="$1" dir
  [ -n "$name" ] || { echo "huse: give a profile name (see: huse ls)" >&2; return 1; }
  dir="$(_huse_dir "$name")"
  [ -d "$dir" ] || { echo "huse: no profile '$name' (see: huse ls)" >&2; return 1; }
  printf '%s' "$dir"
}

# Config folder of one harness in a profile, or in the normal setup (system).
_huse_part() {  # <profile> <harness>
  if [ "$1" != system ]; then
    printf '%s/%s' "$(_huse_dir "$1")" "$2"
    return
  fi
  case "$2" in
    claude) printf '%s' "$HOME/.claude" ;;
    codex)  printf '%s' "$HOME/.codex" ;;
    pi)     printf '%s' "$HOME/.pi/agent" ;;
  esac
}

# ---- profile settings -------------------------------------------------------------

_huse_export_profile() {  # <profile> <dir>
  export HARNESS_PROFILE="$1"
  export CLAUDE_CONFIG_DIR="$2/claude"
  export CODEX_HOME="$2/codex"
  export PI_CODING_AGENT_DIR="$2/pi"
}

# Unset, do not set to the defaults: Claude Code keeps ~/.claude.json outside
# ~/.claude only when CLAUDE_CONFIG_DIR is unset.
_huse_unset_profile() {
  unset HARNESS_PROFILE CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR
}

# ---- commands ------------------------------------------------------------------------

_huse_new() {
  local name="${1:-}" from="" dir tool src
  [ -n "$name" ] || { echo "usage: huse new <profile> [--from system|<profile>]" >&2; return 1; }
  case "$name" in system|off|*/*|.*) echo "huse: bad profile name '$name'" >&2; return 1 ;; esac
  [ "${2:-}" = "--from" ] && from="${3:-}"
  if [ -n "$from" ] && [ "$from" != system ] && [ ! -d "$(_huse_dir "$from")" ]; then
    echo "huse: no profile '$from'" >&2; return 1
  fi
  dir="$(_huse_dir "$name")"
  [ -e "$dir" ] && { echo "huse: profile '$name' already exists" >&2; return 1; }

  for tool in $HARNESSES; do
    mkdir -p "$dir/$tool"
    [ -n "$from" ] || continue
    src="$(_huse_part "$from" "$tool")"
    [ -d "$src" ] || continue
    # Copy config only. Skip logins, sessions, history, logs and caches.
    # Skill links stay links, so the copy uses the same skills of the store.
    find -H "$src" -mindepth 1 -maxdepth 1 | while IFS= read -r entry; do
      case "${entry##*/}" in
        auth.json|.credentials.json|sessions|projects|history.jsonl|todos|\
        shell-snapshots|file-history|statsig|debug|log|logs|cache|*.sqlite*) continue ;;
      esac
      cp -a "$entry" "$dir/$tool/"
    done
  done
  echo "huse: created '$name'${from:+ (copied from $from)} at $dir"
}

# Without shell integration: open a new shell with the profile.
_huse_use() {
  local name="${1:-}" dir
  if [ "$name" = system ]; then _huse_off; return; fi
  dir="$(_huse_profile "$name")" || return 1
  if [ -n "${HUSE_SUBSHELL:-}" ]; then
    echo "huse: this is already a huse shell for '${HARNESS_PROFILE:-system}'. Type exit first." >&2
    echo "huse: to run one command with '$name', use: huse run $name <command>" >&2
    return 1
  fi
  _huse_export_profile "$name" "$dir"
  export HUSE_SUBSHELL=1
  echo "huse: new shell with '$name'. Type exit to go back." >&2
  exec "${SHELL:-/bin/sh}"
}

_huse_off() {
  if [ -n "${HUSE_SUBSHELL:-}" ]; then
    echo "huse: type exit to leave the '${HARNESS_PROFILE:-system}' shell."
  elif [ -n "${HARNESS_PROFILE:-}" ]; then
    echo "huse: huse cannot change the settings of this shell. Open a new shell, or add this line to ~/.zshrc:" >&2
    # shellcheck disable=SC2016  # the line is printed as is, for the user to copy
    echo '  eval "$(huse init)"' >&2
    return 1
  else
    echo "huse: this shell uses your normal setup."
  fi
}

# For shell integration: print shell code for the current shell.
_huse_env() {
  local name="${1:-}" dir
  if [ "$name" = off ] || [ "$name" = system ]; then
    echo 'unset HARNESS_PROFILE CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR'
    echo "huse: this shell uses your normal setup" >&2
    return 0
  fi
  dir="$(_huse_profile "$name")" || return 1
  printf 'export HARNESS_PROFILE=%q CLAUDE_CONFIG_DIR=%q CODEX_HOME=%q PI_CODING_AGENT_DIR=%q\n' \
    "$name" "$dir/claude" "$dir/codex" "$dir/pi"
  echo "huse: this shell uses '$name'" >&2
}

# Shell integration for bash and zsh.
_huse_init() {
  cat <<'EOF'
huse() {
  local _huse_code
  case "${1:-}" in
    use) _huse_code="$(command huse __env "${2:-}")" && eval "$_huse_code" ;;
    off) _huse_code="$(command huse __env off)" && eval "$_huse_code" ;;
    *)   command huse "$@" ;;
  esac
}
EOF
}

_huse_run() {
  [ $# -ge 2 ] || { echo "usage: huse run <profile> <command> [args...]" >&2; return 1; }
  local name="$1" dir
  shift
  if [ "$name" = system ]; then
    _huse_unset_profile
  else
    dir="$(_huse_profile "$name")" || return 1
    _huse_export_profile "$name" "$dir"
  fi
  exec "$@"
}

_huse_list() {
  [ -d "$HARNESS_ROOT/profiles" ] || { echo "huse: no profiles yet" >&2; return 0; }
  local d p
  for d in "$HARNESS_ROOT/profiles"/*/; do
    [ -d "$d" ] || continue
    p="${d%/}"; p="${p##*/}"
    if [ "$p" = "${HARNESS_PROFILE:-}" ]; then echo "* $p"; else echo "  $p"; fi
  done
}

# Names of the entries in ~/.agents/skills. Codex and pi read them in every profile.
_huse_global_skills() {
  local e
  for e in "$HOME/.agents/skills"/*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    printf '%s\n' "${e##*/}"
  done
}

_huse_status() {
  local p="${HARNESS_PROFILE:-system}" n
  if [ -n "${HUSE_SUBSHELL:-}" ]; then
    echo "shell profile:        $p (a huse shell: type exit to leave)"
  else
    echo "shell profile:        $p"
  fi
  echo "CLAUDE_CONFIG_DIR   = ${CLAUDE_CONFIG_DIR:-(unset, uses ~/.claude)}"
  echo "CODEX_HOME          = ${CODEX_HOME:-(unset, uses ~/.codex)}"
  echo "PI_CODING_AGENT_DIR = ${PI_CODING_AGENT_DIR:-(unset, uses ~/.pi/agent)}"
  n="$(_huse_global_skills | wc -l | tr -d ' ')"
  if [ "$n" -gt 0 ]; then
    # shellcheck disable=SC2088  # a literal ~ is intended in these messages
    echo "WARNING: ~/.agents/skills has $n skills. Codex and pi read them in every profile."
    echo "         To choose them per profile, move them to the store: huse setup"
    echo "         Tools such as \`npx skills add -g\` install skills there."
  fi
}

# Make the links of one skill in the harness folders of a profile.
# Sets _huse_added and _huse_had to the harnesses that got a new link or had one.
_huse_link() {  # <profile> <skill> <harness>...
  local p="$1" name="$2" h dir
  shift 2
  _huse_added="" _huse_had=""
  for h in "$@"; do
    dir="$(_huse_part "$p" "$h")/skills"
    mkdir -p "$dir" || return 1
    if [ -L "$dir/$name" ] && [ "$(readlink "$dir/$name")" = "$STORE/$name" ]; then
      _huse_had="$_huse_had $h"
      continue
    fi
    if [ -e "$dir/$name" ] || [ -L "$dir/$name" ]; then
      echo "huse: $dir/$name already exists and is not a link to the store. Kept it." >&2
      continue
    fi
    ln -s "$STORE/$name" "$dir/$name" && _huse_added="$_huse_added $h"
  done
}

# Move the skills in ~/.agents/skills to the store. Link them into the normal setup
# of Codex and pi, which read them before. Never delete a skill.
_huse_setup() {
  local src="$HOME/.agents/skills" name entry target moved=0
  mkdir -p "$STORE" || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    entry="$src/$name"
    if [ -e "$STORE/$name" ] || [ -L "$STORE/$name" ]; then
      echo "huse: $STORE/$name already exists. Kept $entry. Move or rename one of them." >&2
      continue
    fi
    if [ -L "$entry" ]; then
      # A relative link breaks when it moves. Link to the real folder instead.
      if ! target="$(cd "$entry" 2>/dev/null && pwd -P)"; then
        echo "huse: $entry is a broken link. Kept it." >&2
        continue
      fi
      ln -s "$target" "$STORE/$name" && rm -f "${entry:?}"
    else
      mv "$entry" "$STORE/$name"
    fi || { echo "huse: could not move $entry" >&2; continue; }
    _huse_link system "$name" codex pi
    moved=$((moved + 1))
  done <<EOF
$(_huse_global_skills)
EOF
  if [ "$moved" -gt 0 ]; then
    echo "huse: moved $moved skills to $STORE. Your normal setup of Codex and pi still uses them."
  else
    echo "huse: no skills to move. The store is $STORE."
  fi
}

# Check <profile> <skill> [<harness>...] and print the harnesses, one on each line.
_huse_skill_args() {
  local p="${1:-}" name="${2:-}" h
  [ -n "$name" ] || { echo "huse: give a profile and a skill (see: huse skill ls)" >&2; return 1; }
  [ "$p" = system ] || _huse_profile "$p" >/dev/null || return 1
  case "$name" in */*|.*) echo "huse: bad skill name '$name'" >&2; return 1 ;; esac
  shift 2
  # shellcheck disable=SC2086  # HARNESSES is a list of words
  [ $# -gt 0 ] || set -- $HARNESSES
  for h in "$@"; do
    case " $HARNESSES " in
      *" $h "*) printf '%s\n' "$h" ;;
      *) echo "huse: harness must be claude, codex, or pi, not '$h'" >&2; return 1 ;;
    esac
  done
}

_huse_skill() {
  local sub="${1:-ls}" p name hs h dir used
  [ $# -gt 0 ] && shift
  case "$sub" in
    ls)
      p="${1:-${HARNESS_PROFILE:-system}}"
      [ "$p" = system ] || _huse_profile "$p" >/dev/null || return 1
      for dir in "$STORE"/*; do
        [ -e "$dir" ] || continue
        name="${dir##*/}" used=""
        for h in $HARNESSES; do
          [ "$(readlink "$(_huse_part "$p" "$h")/skills/$name" 2>/dev/null)" = "$STORE/$name" ] && used="$used $h"
        done
        if [ -n "$used" ]; then printf '%s  (%s:%s)\n' "$name" "$p" "$used"; else printf '%s\n' "$name"; fi
      done ;;
    add)
      hs="$(_huse_skill_args "$@")" || return 1
      p="$1" name="$2"
      [ -d "$STORE/$name" ] || { echo "huse: no skill '$name' in $STORE (see: huse skill ls)" >&2; return 1; }
      # shellcheck disable=SC2086  # one harness name on each line
      _huse_link "$p" "$name" $hs || return 1
      [ -z "$_huse_added" ] || echo "huse: '$p' now uses $name in:$_huse_added"
      [ -z "$_huse_had" ] || echo "huse: '$p' already used $name in:$_huse_had" ;;
    rm)
      hs="$(_huse_skill_args "$@")" || return 1
      p="$1" name="$2"
      local removed="" missing=""
      for h in $hs; do
        dir="$(_huse_part "$p" "$h")/skills"
        # Remove only links to the store. Never delete a real skill.
        if [ -L "$dir/$name" ] && [ "$(readlink "$dir/$name")" = "$STORE/$name" ]; then
          rm -f "${dir:?}/${name:?}" && removed="$removed $h"
        elif [ -e "$dir/$name" ]; then
          echo "huse: $dir/$name is not a link to the store. Kept it." >&2
        else
          missing="$missing $h"
        fi
      done
      [ -z "$removed" ] || echo "huse: '$p' no longer uses $name in:$removed"
      [ -z "$missing" ] || echo "huse: '$p' did not use $name in:$missing" ;;
    *) echo "usage: huse skill ls|add|rm (see: huse help)" >&2; return 1 ;;
  esac
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift
case "$cmd" in
  new)            _huse_new "$@" ;;
  use)            _huse_use "$@" ;;
  off)            _huse_off ;;
  run)            _huse_run "$@" ;;
  ls|list)        _huse_list ;;
  status)         _huse_status ;;
  setup)          _huse_setup ;;
  skill|skills)   _huse_skill "$@" ;;
  init)           _huse_init ;;
  __env)          _huse_env "$@" ;;
  -h|--help|help) _huse_help ;;
  -V|--version|version) echo "huse $HUSE_VERSION" ;;
  *)              _huse_help; exit 1 ;;
esac
